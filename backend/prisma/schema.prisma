// Prisma schema for Waslny Captain backend.
// Stores captain profiles and the image URLs returned by Cloudinary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Captain {
  id               String   @id @default(cuid())
  firebaseUid      String   @unique
  phone            String?  @unique
  name             String?
  nationalId       String?
  vehicleType      String?
  vehicleModel     String?
  vehicleColor     String?
  vehicleNumber    String?

  // ── Image URLs (populated by the upload endpoints) ──
  photoUrl         String?
  licenseUrl       String?
  idCardUrl        String?
  carPhotoUrl      String?
  insuranceUrl     String?
  criminalRecordUrl String?
  drugTestUrl      String?

  // ── Cloudinary public_ids (so we can delete/replace later) ──
  photoPublicId    String?
  licensePublicId  String?
  idCardPublicId   String?
  carPhotoPublicId String?
  insurancePublicId String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
