# ── Kashier credentials ──
# Copy this file to `.env` and fill in YOUR values.
# `.env` is gitignored; never commit the real secret.

KASHIER_API_KEY=REPLACE_WITH_YOUR_API_KEY
KASHIER_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY
KASHIER_MERCHANT_ID=REPLACE_WITH_YOUR_MERCHANT_ID
KASHIER_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID
KASHIER_BASE_URL=https://api.kashier.io/v3
